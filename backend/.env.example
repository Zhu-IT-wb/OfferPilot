OFFERPILOT_APP_NAME=OfferPilot API
OFFERPILOT_APP_VERSION=0.1.0
OFFERPILOT_API_PREFIX=/api
OFFERPILOT_ENV=local
OFFERPILOT_ENABLE_DEBUG_ROUTES=true
OFFERPILOT_STORAGE_BACKEND=sqlite
OFFERPILOT_SQLITE_PATH=./data/offerpilot.db
# Private Markdown corpus. The source directory stays outside Git.
OFFERPILOT_KNOWLEDGE_SOURCE_PATH=../data/knowledge
OFFERPILOT_KNOWLEDGE_MARKDOWN_SYNC_ENABLED=true

# Public GitHub project analysis. Selected snippets are sent to the configured LLM.
OFFERPILOT_PROJECT_DISCOVERY_ENABLED=true
OFFERPILOT_PROJECT_DISCOVERY_MAX_CONCURRENCY=1
OFFERPILOT_PROJECT_DISCOVERY_CLONE_TIMEOUT_SECONDS=120
OFFERPILOT_PROJECT_DISCOVERY_MAX_GIT_METADATA_MB=100

# Short-answer speech-to-text (Alibaba Cloud Model Studio, Beijing region)
OFFERPILOT_ASR_PROVIDER=bailian
OFFERPILOT_ASR_API_KEY=
OFFERPILOT_ASR_WORKSPACE_ID=
OFFERPILOT_ASR_MODEL=fun-asr-flash-2026-06-15
# Optional override for a compatible regional or test endpoint.
OFFERPILOT_ASR_BASE_URL=
OFFERPILOT_ASR_TIMEOUT_SECONDS=60

# Feishu event subscription config
# Set this to the Verification Token from Feishu event subscription settings.
FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_TIMEOUT_SECONDS=15

# Feishu LeetCode dashboard tab and OAuth
# Use the public HTTPS origin only, without a trailing slash.
OFFERPILOT_DASHBOARD_PUBLIC_BASE_URL=https://your-public-domain.example
OFFERPILOT_DASHBOARD_OAUTH_SCOPE=auth:user.id:read
# Generate a separate random secret for signed dashboard sessions.
OFFERPILOT_DASHBOARD_SESSION_SECRET=
OFFERPILOT_DASHBOARD_SESSION_TTL_SECONDS=604800

# Feishu calendar sync config
FEISHU_CALENDAR_SYNC_ENABLED=false
FEISHU_CALENDAR_ID=primary
FEISHU_CALENDAR_AUTO_CREATE_ENABLED=true
FEISHU_OFFERPILOT_CALENDAR_SUMMARY=OfferPilot 秋招日历
FEISHU_OFFERPILOT_CALENDAR_DESCRIPTION=OfferPilot 自动创建，用于记录秋招投递、笔试和面试提醒。
FEISHU_OFFERPILOT_CALENDAR_PERMISSIONS=private
FEISHU_CALENDAR_TIMEZONE=Asia/Shanghai
FEISHU_INTERVIEW_EVENT_DURATION_MINUTES=60

# Feishu bitable sync config
FEISHU_BITABLE_SYNC_ENABLED=false
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_BITABLE_AUTO_CREATE_ENABLED=true
FEISHU_OFFERPILOT_BITABLE_NAME=OfferPilot 秋招投递表
FEISHU_OFFERPILOT_BITABLE_TABLE_NAME=投递记录
FEISHU_BITABLE_WEB_BASE_URL=https://feishu.cn/base

# DeepSeek-compatible LLM config
# You can use either DEEPSEEK_API_KEY or OFFERPILOT_LLM_API_KEY.
DEEPSEEK_API_KEY=
OFFERPILOT_LLM_PROVIDER=deepseek
OFFERPILOT_LLM_BASE_URL=https://api.deepseek.com
OFFERPILOT_LLM_MODEL=deepseek-v4-flash
OFFERPILOT_LLM_TIMEOUT_SECONDS=30
# Project analysis carries tool history and needs a longer response timeout.
OFFERPILOT_PROJECT_ANALYSIS_LLM_TIMEOUT_SECONDS=180
OFFERPILOT_PROJECT_ANALYSIS_MAX_MODEL_TURNS=30
OFFERPILOT_PROJECT_ANALYSIS_MAX_TOOL_CALLS=80
OFFERPILOT_PROJECT_ANALYSIS_MAX_TOTAL_TOKENS=1500000
OFFERPILOT_PROJECT_ANALYSIS_MAX_REQUEST_CHARS=400000
OFFERPILOT_PROJECT_ANALYSIS_MAX_FINDINGS=12
OFFERPILOT_PROJECT_ANALYSIS_MAX_QUOTE_CHARS=400
OFFERPILOT_LLM_PLANNER_ENABLED=true
OFFERPILOT_LLM_PLANNER_FALLBACK_ENABLED=true

# Persistent conversation compaction. Raw SQLite events are retained for audit.
OFFERPILOT_CONTEXT_COMPACTION_ENABLED=true
OFFERPILOT_CONTEXT_MAX_INPUT_TOKENS=24000
OFFERPILOT_CONTEXT_COMPACTION_TRIGGER_TOKENS=16000
OFFERPILOT_CONTEXT_KEEP_RECENT_TURNS=6
OFFERPILOT_CONTEXT_SUMMARY_MAX_TOKENS=2000
